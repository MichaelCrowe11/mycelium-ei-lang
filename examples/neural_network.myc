// Bio-inspired neural network using mycelium communication patterns.
// A small feed-forward network whose connection strengths depend on the
// environment, with an adapt function that fires when the substrate changes.

environment {
    temperature: 23.0,
    humidity: 80.0,
    substrate_ph: 6.5
}

network MycelialNeuralNet {
    layers: [
        {type: "input", nodes: 8},
        {type: "hidden", nodes: 6, activation: "relu"},
        {type: "hidden", nodes: 4, activation: "sigmoid"},
        {type: "output", nodes: 3, activation: "softmax"}
    ],
    connection_pattern: "mycelial",
    learning_rate: 0.05,
    adaptation_rate: 0.01
}

signal NeuralSignal {
    amplitude: float,
    frequency: float,
    propagation_speed: float
}

mycelium NeuralMycelium {
    network neural_net: MycelialNeuralNet
    signal current_signal: NeuralSignal
    signal weight_scale: float = 1.0

    function train(input_data: array, labels: array) {
        for epoch in range(0, 5) {
            let total_loss = 0.0
            for i in range(0, len(input_data)) {
                let output = forward_propagate(input_data[i])
                let loss = ecological_loss(output, labels[i])
                total_loss = total_loss + loss
                backpropagate_signals(loss)
            }
            print("Epoch", epoch, "- loss:", round(total_loss / len(input_data), 4))
        }
    }

    function forward_propagate(input: array) -> array {
        current_signal.amplitude = max(input)
        let activation = input
        let depth = 0
        for layer in neural_net.layers {
            if layer.type != "input" {
                activation = propagate_through_layer(activation, layer)
                // Signals weaken as they travel deeper through the mycelium
                activation = apply_signal_decay(activation, depth * current_signal.propagation_speed)
            }
            depth = depth + 1
        }
        return activation
    }

    function propagate_through_layer(input: array, layer: object) -> array {
        let output = []
        for node in range(0, layer.nodes) {
            let sum = 0.0
            for i in range(0, len(input)) {
                sum = sum + input[i] * get_mycelial_strength(i, node)
            }
            if layer.activation == "softmax" {
                output.append(sum)
            } else {
                output.append(apply_activation(sum, layer.activation))
            }
        }
        if layer.activation == "softmax" {
            return apply_activation(output, "softmax")
        }
        return output
    }

    function ecological_loss(output: array, label: array) -> float {
        let loss = 0.0
        for i in range(0, len(output)) {
            let diff = output[i] - label[i]
            loss = loss + diff * diff
        }
        return loss
    }

    function backpropagate_signals(loss: float) {
        // Chemical gradient diffusing back through the layers, decaying at each one
        let gradient = loss * neural_net.learning_rate
        for layer in reverse(neural_net.layers) {
            gradient = gradient * 0.9
        }
        weight_scale = weight_scale * (1.0 - gradient)
    }

    adapt function respond_to_substrate() {
        let ph = get_env("substrate_ph")
        if ph < 6.0 || ph > 7.0 {
            neural_net.learning_rate = neural_net.learning_rate * 0.8
            print("Adapting to substrate stress: learning rate now", round(neural_net.learning_rate, 4))
        }
        let temp = get_env("temperature")
        current_signal.propagation_speed = 1.0 + (temp - 20.0) * 0.05
    }

    function get_mycelial_strength(from: int, to: int) -> float {
        let distance = abs(from - to)
        let base_strength = 1.0 / (1.0 + distance * 0.1)
        let env_factor = get_env("humidity") / 100.0
        return base_strength * env_factor * weight_scale
    }
}

function generate_ecological_patterns(count: int) -> array {
    let patterns = []
    for i in range(0, count) {
        let pattern = []
        for j in range(0, 8) {
            pattern.append(sin(i * 0.1 + j * 0.2) * cos(j * 0.15))
        }
        patterns.append(pattern)
    }
    return patterns
}

function generate_labels(data: array) -> array {
    let labels = []
    for pattern in data {
        let sum = 0.0
        for value in pattern {
            sum = sum + value
        }
        let label_index = int(abs(sum) * 10.0) % 3
        labels.append(create_one_hot(label_index, 3))
    }
    return labels
}

function main() {
    let mycelial_ai = new NeuralMycelium()
    let training_data = generate_ecological_patterns(20)
    let labels = generate_labels(training_data)

    print("Starting bio-inspired neural network training...")
    mycelial_ai.train(training_data, labels)

    // The substrate turns acidic: the adapt function fires on the change
    set_env("substrate_ph", 5.5)

    let test_input = [0.5, 0.3, 0.8, 0.2, 0.6, 0.9, 0.1, 0.7]
    let prediction = mycelial_ai.forward_propagate(test_input)
    print("Prediction for test input:", prediction)
    print("Training complete - Mycelial neural network ready")
}
